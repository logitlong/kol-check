# 只有"在自己电脑上运行"才需要这个文件。线上部署不需要，key 都由使用者在网页上填。
# 复制本文件为 .env，按需填写后重启。.env 已在 .gitignore 里，不会被提交。

# 抓帖 key（twitterapi.io）。填了以后本机使用时网页上可以不再填
TWITTERAPI_IO_KEY=

# 可选：X 官方 API 的 Bearer Token（比 twitterapi.io 贵很多，一般不需要）
X_BEARER_TOKEN=

# 可选：Claude API key。本机装了 Claude Code 时不需要，会直接用本机登录
ANTHROPIC_API_KEY=

# 可选：本机 Claude 默认用的模型
# EXTRACT_MODEL=claude-opus-5-5

# 线上部署时由平台设置，本机不要打开
# HOSTED=1
